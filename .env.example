# Copy this file to .env and fill in the values from your Supabase project:
# Dashboard → Project Settings → API Keys (use the *publishable* / anon key,
# never the secret / service_role key).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
